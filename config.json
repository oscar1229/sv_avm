{
  // 是否使用 live VI 摄像头输入；摄像头不可用时自动回退为读取图片
  "live_vi": true,

  // 渲染帧数；0 表示一直运行到 Ctrl+C
  "frames": 0,

  // 每帧节流睡眠，单位微秒；0 表示不主动 sleep
  "sleep_us": 0,

  // 碗面网格细分数；可选 90/180/360/720
  "grid_subdiv": 180,

  // live VI 输入参数
  "live_vi_dev": 0,
  "live_vi_width": 1280,
  "live_vi_height": 720,
  "live_vi_timeout_ms": 33,
  "live_vi_mipi_lanes": 4,
  "live_vi_mbps": 800,

  // true 表示强制使用图片输入，跳过摄像头（用于无摄像头环境调试）
  // false 表示优先使用摄像头，仅在摄像头不可用时回退为图片
  "use_fallback_image": false,

  // 摄像头不可用时读取的图片目录（相对工程根目录）
  // 需包含 imagech0.jpg ~ imagech3.jpg
  "fallback_image_dir": "sv_avm_test/res",

  // true 表示强制离屏渲染，即使显示器可用（需同时配置 offscreen_output_path）
  // false 表示自动检测：仅在显示器不可用时离屏渲染
  "force_offscreen": false,

  // 无显示器时离屏渲染结果的保存路径（相对工程根目录）
  // 仅在检测到无显示器时生效；有显示器时忽略该配置
  // 渲染结束（帧数用尽或 Ctrl+C）时保存最后一帧
  "offscreen_output_path": "output/render.jpg"
}
